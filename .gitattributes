# Corpora, manifests and reports are pinned by the SHA-256 of their bytes,
# and the grammar documents are checked line by line against the code. A
# Windows checkout with core.autocrlf would rewrite them as CRLF and break
# both, so they keep LF on every platform.
research/** text eol=lf
docs/grammar/** text eol=lf

# Binary formats are never text, wherever they live — an audio clip moved
# under research/ must not have its bytes "normalised" by the rule above.
*.caf binary
*.wav binary
*.flac binary
*.mp3 binary
*.png binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
